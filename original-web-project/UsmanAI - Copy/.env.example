# Optional, but recommended for full AI answers.
# Copy this file to .env and add your own provider key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Keep these defaults for local desktop development.
HOST=127.0.0.1
PORT=5000
# Set COOKIE_SECURE=1 only when serving over HTTPS.
COOKIE_SECURE=0
# Replace this with a long random secret before deploying publicly.
SECRET_KEY=replace-this-with-a-long-random-secret
